# Public site origin — MUST match the live host exactly (scheme + host, no
# trailing slash). Feeds every canonical URL, the sitemap, robots.txt and the
# OpenGraph/JSON-LD absolute URLs. If this does not match what the browser
# actually loads, Google sees canonicals pointing at a different host and the
# site may not be indexed. Falls back to https://acctqai.com when unset.
DOMAIN="https://acctqai.com"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiql_erp"

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Encryption — generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""

# AWS (ap-south-1)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Gmail (use an App Password, not your real password)
# Enable at: myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""

# Microsoft OAuth — Sprint 10
# MICROSOFT_TENANT_ID="common"
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"
